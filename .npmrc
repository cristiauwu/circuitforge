# Configuración de pnpm para el monorepo CircuitForge.

registry=https://registry.npmjs.org/

# pnpm ejecuta una verificación de dependencias ("runDepsStatusCheck") antes de cada
# script, que internamente lanza `pnpm install`. En este entorno ese install secundario
# falla con ERR_PNPM_IGNORED_BUILDS, abortando comandos que no tienen nada que ver.
# Las dependencias ya están instaladas y verificadas en el paso de instalación, así que
# la re-verificación previa a cada script es redundante aquí.
verify-deps-before-run=false

# Los paquetes que necesitan binario nativo (esbuild, @biomejs/biome) ya lo traen como
# optionalDependency y sus `postinstall` son redundantes. Este entorno no expone `node`
# en el PATH de procesos hijos, así que esos scripts fallarían igualmente.
ignore-scripts=true

# Enlaces estrictos: impide importar dependencias no declaradas.
strict-peer-dependencies=false
auto-install-peers=true
